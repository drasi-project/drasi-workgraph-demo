{
  "marker": "WorkGraphWorkflowDefinition/v1",
  "workflowDefinitionId": "issue-lifecycle",
  "version": "v1",
  "trigger": "workgraph",
  "initialStepId": "a",
  "defaults": {
    "evaluator": "result-evaluator",
    "orchestrator": "workflow-coordinator",
    "maxReworkAttempts": 3
  },
  "steps": {
    "a": {
      "stepId": "a",
      "type": "task",
      "task": {
        "taskDefinitionId": "a",
        "operation": "intake-issue",
        "worker": "issue-worker",
        "inputs": {},
        "evaluator": "result-evaluator",
        "orchestrator": "workflow-coordinator",
        "maxReworkAttempts": 3
      }
    },
    "b": {
      "stepId": "b",
      "type": "task",
      "task": {
        "taskDefinitionId": "b",
        "operation": "normalize-issue",
        "worker": "issue-worker",
        "inputs": {},
        "evaluator": "result-evaluator",
        "orchestrator": "workflow-coordinator",
        "maxReworkAttempts": 3
      }
    },
    "c": {
      "stepId": "c",
      "type": "task",
      "task": {
        "taskDefinitionId": "c",
        "operation": "validate-issue",
        "worker": "issue-validator",
        "inputs": {
          "profile": "new-issue-default"
        },
        "evaluator": "issue-validation-evaluator",
        "orchestrator": "workflow-coordinator",
        "maxReworkAttempts": 3
      }
    },
    "d": {
      "stepId": "d",
      "type": "task",
      "task": {
        "taskDefinitionId": "d",
        "operation": "request-information",
        "worker": "issue-info-requester",
        "inputs": {
          "source": "c"
        },
        "evaluator": "result-evaluator",
        "orchestrator": "workflow-coordinator",
        "maxReworkAttempts": 3
      }
    },
    "human": {
      "stepId": "human",
      "type": "wait",
      "event": "root-issue-commented"
    },
    "e": {
      "stepId": "e",
      "type": "task",
      "task": {
        "taskDefinitionId": "e",
        "operation": "triage-issue",
        "worker": "issue-worker",
        "inputs": {},
        "evaluator": "result-evaluator",
        "orchestrator": "workflow-coordinator",
        "maxReworkAttempts": 3
      }
    },
    "f": {
      "stepId": "f",
      "type": "task",
      "task": {
        "taskDefinitionId": "f",
        "operation": "record-rejection",
        "worker": "issue-worker",
        "inputs": {},
        "evaluator": "result-evaluator",
        "orchestrator": "workflow-coordinator",
        "maxReworkAttempts": 3
      }
    },
    "g": {
      "stepId": "g",
      "type": "task",
      "task": {
        "taskDefinitionId": "g",
        "operation": "coordinate-validation",
        "worker": "issue-worker",
        "inputs": {},
        "evaluator": "result-evaluator",
        "orchestrator": "validation-stage-coordinator",
        "maxReworkAttempts": 2,
        "children": {
          "join": "all",
          "tasks": {
            "title": {
              "operation": "validate-title",
              "worker": "issue-validator",
              "inputs": {
                "field": "title"
              },
              "evaluator": "result-evaluator",
              "orchestrator": "validation-stage-coordinator",
              "maxReworkAttempts": 2
            },
            "body": {
              "operation": "validate-body",
              "worker": "issue-validator",
              "inputs": {
                "field": "body"
              },
              "evaluator": "result-evaluator",
              "orchestrator": "validation-stage-coordinator",
              "maxReworkAttempts": 2
            },
            "reproduction": {
              "operation": "validate-reproduction",
              "worker": "issue-validator",
              "inputs": {
                "section": "reproduction"
              },
              "evaluator": "result-evaluator",
              "orchestrator": "validation-stage-coordinator",
              "maxReworkAttempts": 2
            }
          }
        }
      }
    },
    "h": {
      "stepId": "h",
      "type": "task",
      "task": {
        "taskDefinitionId": "h",
        "operation": "finalize-issue",
        "worker": "issue-worker",
        "inputs": {},
        "evaluator": "result-evaluator",
        "orchestrator": "workflow-coordinator",
        "maxReworkAttempts": 3
      }
    },
    "completed": {
      "stepId": "completed",
      "type": "terminal",
      "outcome": "completed"
    },
    "error": {
      "stepId": "error",
      "type": "terminal",
      "outcome": "error"
    },
    "ignored": {
      "stepId": "ignored",
      "type": "terminal",
      "outcome": "ignored"
    }
  },
  "transitions": [
    {
      "sourceStepId": "a",
      "targetStepId": "b"
    },
    {
      "sourceStepId": "b",
      "targetStepId": "c"
    },
    {
      "sourceStepId": "c",
      "outcome": "needs-info",
      "targetStepId": "d"
    },
    {
      "sourceStepId": "c",
      "outcome": "continue",
      "targetStepId": "e"
    },
    {
      "sourceStepId": "c",
      "outcome": "reject",
      "targetStepId": "f"
    },
    {
      "sourceStepId": "d",
      "outcome": "requested",
      "targetStepId": "human"
    },
    {
      "sourceStepId": "human",
      "outcome": "root-issue-commented",
      "targetStepId": "c"
    },
    {
      "sourceStepId": "e",
      "targetStepId": "g"
    },
    {
      "sourceStepId": "f",
      "outcome": "ignored",
      "targetStepId": "ignored"
    },
    {
      "sourceStepId": "g",
      "targetStepId": "h"
    },
    {
      "sourceStepId": "h",
      "outcome": "completed",
      "targetStepId": "completed"
    }
  ]
}
